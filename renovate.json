{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>StackVista/renovate-config#v1.1.0",
    "github>StackVista/renovate-config:go#v1.1.0",
    "github>StackVista/renovate-config:docker#v1.1.0",
    "github>StackVista/renovate-config:automerge#v1.1.0"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update OpenTelemetry components in the OCB builder manifests",
      "managerFilePatterns": [
        "/(^|/)[^/]+-otel-builder\\.yaml$/"
      ],
      "matchStrings": [
        "- gomod: (?<depName>(?:go\\.opentelemetry\\.io/collector|github\\.com/open-telemetry/opentelemetry-collector-contrib)/\\S+) (?<currentValue>v\\S+)"
      ],
      "datasourceTemplate": "go"
    },
    {
      "customType": "regex",
      "description": "Update module replacements pinned by the OCB builder manifests, which override go.mod versions in the built distributions",
      "managerFilePatterns": [
        "/(^|/)[^/]+-otel-builder\\.yaml$/"
      ],
      "matchStrings": [
        "- (?<depName>[^\\s=]+) => (?<packageName>[^\\s=]+) (?<currentValue>v\\S+)"
      ],
      "datasourceTemplate": "go"
    },
    {
      "customType": "regex",
      "description": "Update the OCB builder installed by the image builds",
      "managerFilePatterns": [
        "/(^|/)Dockerfile[^/]*$/"
      ],
      "matchStrings": [
        "go install (?<depName>go\\.opentelemetry\\.io/collector/cmd/builder)@(?<currentValue>v\\S+)"
      ],
      "datasourceTemplate": "go"
    }
  ],
  "packageRules": [
    {
      "matchDatasources": ["golang-version"],
      "separateMinorPatch": true
    },
    {
      "matchPackageNames": ["StackVista/image-pipeline"],
      "enabled": false
    },
    {
      "description": "Leave developer examples, which CI does not build, out of automated updates",
      "matchFileNames": [
        "**/example/**"
      ],
      "enabled": false
    },
    {
      "description": "Update the compiler with scripts/upgrade_go_version.sh, which keeps go.work and every module on one version",
      "matchManagers": [
        "gomod"
      ],
      "matchDepTypes": [
        "golang",
        "toolchain"
      ],
      "enabled": false
    },
    {
      "description": "Update the compiler with scripts/upgrade_go_version.sh, which keeps go.work and every module on one version",
      "matchManagers": [
        "mise"
      ],
      "matchDepNames": [
        "go"
      ],
      "enabled": false
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "registry.suse.com/bci/golang"
      ],
      "allowedVersions": "/^\\d+\\.\\d+(\\.\\d+)*$/",
      "separateMinorPatch": true
    },
    {
      "description": "Keep the runtime image on the approved BCI release",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "registry.suse.com/bci/bci-micro"
      ],
      "allowedVersions": "/^15\\.7(?:[.-]|$)/"
    },
    {
      "description": "Review ClickHouse test server refreshes separately because the digest tracks latest",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "clickhouse/clickhouse-server"
      ],
      "groupName": null,
      "groupSlug": null,
      "automerge": false,
      "rebaseWhen": "conflicted"
    },
    {
      "description": "Keep OpenTelemetry patch and minor releases in one branch with their manifest pins",
      "matchPackageNames": [
        "go.opentelemetry.io/collector",
        "go.opentelemetry.io/collector/**",
        "github.com/open-telemetry/opentelemetry-collector-contrib/**",
        "go.opentelemetry.io/otel",
        "go.opentelemetry.io/otel/**",
        "go.opentelemetry.io/contrib/**"
      ],
      "separateMinorPatch": false
    },
    {
      "description": "Review OpenTelemetry releases in one PR with the builder manifests that pin them",
      "matchPackageNames": [
        "go.opentelemetry.io/collector",
        "go.opentelemetry.io/collector/**",
        "github.com/open-telemetry/opentelemetry-collector-contrib/**",
        "go.opentelemetry.io/otel",
        "go.opentelemetry.io/otel/**",
        "go.opentelemetry.io/contrib/**"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "groupName": "OpenTelemetry Collector",
      "groupSlug": "opentelemetry-collector",
      "automerge": false,
      "rebaseWhen": "conflicted"
    },
    {
      "description": "Keep modules pinned by builder manifest replacements in one branch with those pins",
      "matchPackageNames": [
        "github.com/goccy/go-json",
        "github.com/klauspost/compress",
        "golang.org/x/crypto",
        "google.golang.org/grpc"
      ],
      "separateMinorPatch": false
    },
    {
      "description": "Review modules pinned by builder manifest replacements together with the replacement pins that ship",
      "matchPackageNames": [
        "github.com/goccy/go-json",
        "github.com/klauspost/compress",
        "golang.org/x/crypto",
        "google.golang.org/grpc"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "groupName": "Builder-pinned Go modules",
      "groupSlug": "builder-pinned-go-modules",
      "automerge": false,
      "rebaseWhen": "conflicted"
    },
    {
      "matchManagers": [
        "renovate-config",
        "github-actions"
      ],
      "matchPackageNames": [
        "StackVista/renovate-config"
      ],
      "groupName": "Renovate configuration",
      "groupSlug": "renovate-config",
      "separateMajorMinor": false,
      "separateMinorPatch": false,
      "automerge": false
    },
    {
      "matchDatasources": ["golang-version", "docker"],
      "matchPackageNames": ["go", "golang/go", "registry.suse.com/bci/golang"],
      "matchUpdateTypes": ["patch", "digest", "pinDigest"],
      "group": {"branchTopic": "go-build-environment"}
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "registry.suse.com/bci/golang"
      ],
      "matchUpdateTypes": [
        "minor",
        "major"
      ],
      "groupName": "Go toolchain",
      "groupSlug": "go-toolchain",
      "automerge": false
    }
  ]
}
