{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>StackVista/renovate-config#10734b53596c7bf4649ece6cbb2284a9899aaea1",
    "github>StackVista/renovate-config:go#10734b53596c7bf4649ece6cbb2284a9899aaea1",
    "github>StackVista/renovate-config:docker#10734b53596c7bf4649ece6cbb2284a9899aaea1",
    "github>StackVista/renovate-config:automerge#10734b53596c7bf4649ece6cbb2284a9899aaea1"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update OCB components, replacement pins and the builder installed by image builds",
      "managerFilePatterns": [
        "/(^|/)[^/]+-otel-builder\\.yaml$/",
        "/(^|/)Dockerfile[^/]*$/"
      ],
      "matchStrings": [
        "- gomod: (?<depName>(?:go\\.opentelemetry\\.io/collector|github\\.com/open-telemetry/opentelemetry-collector-contrib)/\\S+) (?<currentValue>v\\S+)",
        "- (?<depName>[^\\s=]+) => (?<packageName>[^\\s=]+) (?<currentValue>v\\S+)",
        "go install (?<depName>go\\.opentelemetry\\.io/collector/cmd/builder)@(?<currentValue>v\\S+)"
      ],
      "datasourceTemplate": "go"
    }
  ],
  "vulnerabilityAlerts": {
    "branchTopic": "{{#if (or (equals depName \"github.com/oapi-codegen/oapi-codegen/v2\") (equals depName \"github.com/getkin/kin-openapi\"))}}openapi-generator{{else}}{{{datasource}}}-{{{depNameSanitized}}}-vulnerability{{/if}}"
  },
  "packageRules": [
    {
      "description": "Keep the OpenAPI generator and parser compatible",
      "matchPackageNames": [
        "github.com/oapi-codegen/oapi-codegen/v2",
        "github.com/getkin/kin-openapi"
      ],
      "groupName": "OpenAPI generator",
      "groupSlug": "openapi-generator",
      "separateMajorMinor": false,
      "separateMinorPatch": false,
      "commitMessageTopic": "OpenAPI generator",
      "commitMessageExtra": ""
    },
    {
      "description": "Leave developer examples, which CI does not build, out of automated updates",
      "matchFileNames": [
        "**/example/**"
      ],
      "enabled": false
    },
    {
      "description": "Update the compiler with scripts/upgrade_go_version.sh, which keeps go.work and every module on one version",
      "matchManagers": [
        "gomod",
        "mise"
      ],
      "matchPackageNames": [
        "go",
        "golang/go"
      ],
      "enabled": false
    },
    {
      "description": "Keep the runtime image on the approved BCI release",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "registry.suse.com/bci/bci-micro"
      ],
      "allowedVersions": "/^15\\.7(?:[.-]|$)/"
    },
    {
      "description": "Review ClickHouse test server refreshes separately because the digest tracks latest",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "clickhouse/clickhouse-server"
      ],
      "groupName": null,
      "groupSlug": null,
      "automerge": false,
      "rebaseWhen": "conflicted"
    },
    {
      "description": "Review OpenTelemetry releases in one PR with the builder manifests that pin them",
      "matchPackageNames": [
        "go.opentelemetry.io/collector",
        "go.opentelemetry.io/collector/**",
        "github.com/open-telemetry/opentelemetry-collector-contrib/**",
        "go.opentelemetry.io/otel",
        "go.opentelemetry.io/otel/**",
        "go.opentelemetry.io/contrib/**"
      ],
      "groupName": "OpenTelemetry Collector",
      "groupSlug": "opentelemetry-collector",
      "automerge": false,
      "rebaseWhen": "conflicted",
      "separateMinorPatch": false
    },
    {
      "description": "Review modules pinned by builder manifest replacements together with the replacement pins that ship",
      "matchPackageNames": [
        "github.com/goccy/go-json",
        "github.com/klauspost/compress",
        "golang.org/x/crypto",
        "google.golang.org/grpc"
      ],
      "groupName": "Builder-pinned Go modules",
      "groupSlug": "builder-pinned-go-modules",
      "automerge": false,
      "rebaseWhen": "conflicted",
      "separateMinorPatch": false
    }
  ]
}
