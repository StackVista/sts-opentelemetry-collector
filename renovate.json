{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>StackVista/renovate-config#v1.3.0",
    "github>StackVista/renovate-config:go#v1.3.0",
    "github>StackVista/renovate-config:docker#v1.3.0",
    "github>StackVista/renovate-config:automerge#v1.3.0"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update OCB components, replacement pins and the builder installed by image builds",
      "managerFilePatterns": [
        "/(^|/)[^/]+-otel-builder\\.yaml$/",
        "/(^|/)Dockerfile[^/]*$/"
      ],
      "matchStrings": [
        "- gomod: (?<depName>(?:go\\.opentelemetry\\.io/collector|github\\.com/open-telemetry/opentelemetry-collector-contrib)/\\S+) (?<currentValue>v\\S+)",
        "- (?<depName>[^\\s=]+) => (?<packageName>[^\\s=]+) (?<currentValue>v\\S+)",
        "go install (?<depName>go\\.opentelemetry\\.io/collector/cmd/builder)@(?<currentValue>v\\S+)"
      ],
      "datasourceTemplate": "go"
    },
    {
      "customType": "regex",
      "description": "Update the Go workspace compiler with the module and build versions",
      "managerFilePatterns": [
        "/(^|/)go\\.work$/"
      ],
      "matchStrings": [
        "(?:^|\\n)go (?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "golang-version",
      "depNameTemplate": "go"
    }
  ],
  "vulnerabilityAlerts": {
    "branchTopic": "{{#if (or (equals depName \"github.com/oapi-codegen/oapi-codegen/v2\") (or (equals depName \"github.com/oapi-codegen/runtime\") (equals depName \"github.com/getkin/kin-openapi\")))}}openapi-generator{{else}}{{{datasource}}}-{{{depNameSanitized}}}-vulnerability{{/if}}"
  },
  "packageRules": [
    {
      "description": "Use checked-out source for internal Go modules",
      "matchManagers": [
        "gomod"
      ],
      "matchPackageNames": [
        "github.com/stackvista/sts-opentelemetry-collector/**"
      ],
      "enabled": false
    },
    {
      "description": "Keep the OpenAPI generator, runtime and parser compatible",
      "matchPackageNames": [
        "github.com/oapi-codegen/oapi-codegen/v2",
        "github.com/oapi-codegen/runtime",
        "github.com/getkin/kin-openapi"
      ],
      "groupName": "OpenAPI generator",
      "groupSlug": "openapi-generator",
      "separateMajorMinor": false,
      "separateMinorPatch": false
    },
    {
      "description": "Leave developer examples, which CI does not build, out of automated updates",
      "matchFileNames": [
        "**/example/**"
      ],
      "enabled": false
    },
    {
      "description": "Update Go across the workspace, modules, CI, Mise and builder images together",
      "matchPackageNames": [
        "go",
        "golang/go",
        "registry.suse.com/bci/golang"
      ],
      "enabled": true,
      "rangeStrategy": "bump",
      "minimumReleaseAge": null,
      "groupName": "Go toolchain",
      "groupSlug": "go-toolchain",
      "separateMinorPatch": true
    },
    {
      "matchPackageNames": [
        "go",
        "golang/go",
        "registry.suse.com/bci/golang"
      ],
      "matchUpdateTypes": [
        "patch",
        "digest",
        "pinDigest"
      ],
      "groupName": "Go build environment",
      "groupSlug": "go-build-environment",
      "automerge": true,
      "rebaseWhen": "behind-base-branch"
    },
    {
      "description": "Keep the runtime image on the approved BCI release",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "registry.suse.com/bci/bci-micro"
      ],
      "allowedVersions": "/^15\\.7(?:[.-]|$)/"
    },
    {
      "description": "Track ClickHouse releases and SUSE Observability rebuilds",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "registry.tooling.stackstate.io/quay/stackstate/clickhouse"
      ],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\.(?<build>\\d+)-so(?<revision>\\d+)$"
    },
    {
      "description": "Review OpenTelemetry releases in one PR with the builder manifests that pin them",
      "matchPackageNames": [
        "go.opentelemetry.io/collector",
        "go.opentelemetry.io/collector/**",
        "github.com/open-telemetry/opentelemetry-collector-contrib/**",
        "go.opentelemetry.io/otel",
        "go.opentelemetry.io/otel/**",
        "go.opentelemetry.io/contrib/**"
      ],
      "groupName": "OpenTelemetry Collector",
      "groupSlug": "opentelemetry-collector",
      "automerge": false,
      "rebaseWhen": "conflicted",
      "separateMinorPatch": false
    },
    {
      "description": "Review modules pinned by builder manifest replacements together with the replacement pins that ship",
      "matchPackageNames": [
        "github.com/goccy/go-json",
        "github.com/klauspost/compress",
        "golang.org/x/crypto",
        "google.golang.org/grpc"
      ],
      "groupName": "Builder-pinned Go modules",
      "groupSlug": "builder-pinned-go-modules",
      "automerge": false,
      "rebaseWhen": "conflicted",
      "separateMinorPatch": false
    }
  ],
  "postUpgradeTasks": {
    "commands": [
      "bash scripts/renovate-codegen.sh"
    ],
    "executionMode": "branch",
    "fileFilters": [
      "extension/settingsproviderextension/generated/settingsproto/model.gen.go",
      "extension/settingsproviderextension/generated/settingsschema/model.gen.go",
      "go.work.sum"
    ]
  }
}
